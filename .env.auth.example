# Polysmart authentication runtime example
# Copy only the values you actually need into Cloudflare vars / secrets.

# Public app base URL
APP_BASE_URL=https://www.polysmart.io

# Logto public vars
LOGTO_ENDPOINT=https://your-logto-tenant.logto.app
LOGTO_APP_ID=replace-with-logto-app-id

# Cloudflare Turnstile public var
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Secret values
# Configure these with `wrangler secret put`, not in source control.
LOGTO_APP_SECRET=replace-with-logto-app-secret
LOGTO_COOKIE_SECRET=replace-with-a-long-random-cookie-secret
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
